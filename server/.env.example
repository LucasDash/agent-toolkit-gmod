# Copy to .env only when overriding these local defaults.
SERVER_BRANCH=x86-64
SERVER_MAP=gm_construct
SERVER_GAMEMODE=sandbox
SERVER_PORT=28115
HOST_GAME_PORT=28115
SERVER_MAXPLAYERS=8
# Keep loopback-only by default. On Windows Docker Desktop, set this to the host's
# LAN IPv4 if a local GMod client cannot complete the game connection via loopback.
# Binding to a LAN address allows other devices on that local network to connect.
SERVER_BIND_ADDRESS=127.0.0.1
STEAMCMD_STAGING_PATH=./.steamcmd-cache

# GTerm TCP is unauthenticated. Keep it loopback-only and use an SSH tunnel remotely.
GTERM_HOST_PORT=27516
GTERM_BIND_ADDRESS=127.0.0.1
